# ─────────────────────────────────────────────────────────────────────────────
# AgentMesh — Environment Configuration
# Copy this to .env and fill in your values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://agentmesh:agentmesh_dev_password@localhost:5432/agentmesh
# For production with read replicas:
# DATABASE_URL_REPLICA=postgresql://agentmesh:password@readonly.db.host:5432/agentmesh

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:redis_dev_password@localhost:6379
# REDIS_CLUSTER_URL=redis://cluster.host:6379  # For production

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://agentmesh:rabbitmq_dev_password@localhost:5672

# ── Security ──────────────────────────────────────────────────────────────────
# API key for authenticating requests to the gateway
AGENTMESH_API_KEY=dev-api-key-change-in-production

# 32-character key for AES-256-GCM encryption of bot credentials in DB
ENCRYPTION_KEY=32-char-dev-encryption-key!!!!!

# JWT signing secret
JWT_SECRET=jwt-secret-change-in-production

# ── Webhooks ──────────────────────────────────────────────────────────────────
# Public URL where platforms can send webhook events
# For local dev, use ngrok: ngrok http 3000
WEBHOOK_BASE_URL=https://your-domain.com

# ── LLM Providers ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
OPENAI_API_KEY=sk-your-openai-key-here
GOOGLE_AI_API_KEY=AIzaSy-your-google-ai-key-here
GROQ_API_KEY=gsk_your-groq-key-here

# For self-hosted Ollama
# OLLAMA_BASE_URL=http://localhost:11434

# ── Agent Configuration ────────────────────────────────────────────────────────
MAX_CONCURRENCY=50         # Max concurrent LLM calls per agent instance
AGENT_TIMEOUT_MS=30000     # LLM call timeout
RETRY_ATTEMPTS=2
RETRY_DELAY_MS=1000

# ── Bot Registry ──────────────────────────────────────────────────────────────
HEALTH_CHECK_INTERVAL_MS=30000
STALE_BOT_THRESHOLD_MS=60000
MAX_BOTS_PER_PLATFORM=0    # 0 = unlimited

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
OPENTELEMETRY_ENDPOINT=http://localhost:4317

# ── Scaling ───────────────────────────────────────────────────────────────────
SWARM_SCALE_CHECK_INTERVAL_MS=10000
MIN_SWARM_HEALTH_SCORE=50

# ── Admin Dashboard ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000/events
